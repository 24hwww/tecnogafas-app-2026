{
	"openapi": "3.0.0",
	"info": {
		"title": "API TecnoGafas",
		"description": "API RESTful para la gestión de productos, clientes y pedidos de TecnoGafas. Soporta operaciones CRUD, autenticación Bearer y paginación estandarizada.",
		"contact": {
			"name": "Soporte TecnoGafas",
			"email": "soporte@tecnogafas.com"
		},
		"version": "2.1.0"
	},
	"servers": [
		{
			"url": "/",
			"description": "Servidor Principal"
		}
	],
	"paths": {
		"/": {
			"get": {
				"tags": ["Documentación"],
				"summary": "Mostrar documentación de la API (Swagger UI)",
				"description": "Retorna la interfaz de Swagger UI para explorar la API",
				"operationId": "getSwaggerUI",
				"responses": {
					"200": {
						"description": "Swagger UI HTML"
					}
				}
			}
		},
		"/openapi-spec": {
			"get": {
				"tags": ["Documentación"],
				"summary": "Obtener la especificación OpenAPI en formato JSON",
				"description": "Retorna la especificación OpenAPI 3.0 en formato JSON",
				"operationId": "getOpenAPISpec",
				"responses": {
					"200": {
						"description": "Especificación OpenAPI JSON",
						"content": {
							"application/json": {
								"schema": {
									"type": "object"
								}
							}
						}
					},
					"500": {
						"description": "Error interno",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ErrorResponse"
								}
							}
						}
					}
				}
			}
		},
		"/productos": {
			"get": {
				"tags": ["Productos"],
				"summary": "Listar todos los productos",
				"description": "Obtiene el listado completo de productos con sus variaciones y filtros. Opcionalmente puede filtrar por SKU.",
				"operationId": "getProductos",
				"parameters": [
					{
						"name": "sku",
						"in": "path",
						"description": "SKU del producto para filtrar (opcional)",
						"required": false,
						"schema": {
							"type": "string",
							"example": "lente-001"
						}
					}
				],
				"responses": {
					"200": {
						"description": "Lista de productos obtenida exitosamente",
						"content": {
							"application/json": {
								"schema": {
									"allOf": [
										{
											"properties": {
												"count": {
													"type": "integer",
													"example": 100
												},
												"data": {
													"type": "array",
													"items": {
														"$ref": "#/components/schemas/Product"
													}
												}
											},
											"type": "object"
										},
										{
											"$ref": "#/components/schemas/SuccessResponse"
										}
									]
								}
							}
						}
					},
					"500": {
						"description": "Error interno del servidor",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ErrorResponse"
								}
							}
						}
					}
				}
			}
		},
		"/producto/verificar": {
			"post": {
				"tags": ["Productos"],
				"summary": "Verificar múltiples productos y variaciones",
				"description": "Verifica uno o varios productos comparando precio y stock con la base de datos. Retorna resultado individual por cada producto.",
				"operationId": "verificarProductos",
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"$ref": "#/components/schemas/ProductVerificationRequest"
							}
						}
					}
				},
				"responses": {
					"200": {
						"description": "Verificación completada - ver campo 'failed' para ver productos alterados",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ProductVerificationResponse"
								}
							}
						}
					},
					"422": {
						"description": "Datos inválidos o faltantes",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ErrorResponse"
								}
							}
						}
					},
					"500": {
						"description": "Error interno del servidor",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ErrorResponse"
								}
							}
						}
					}
				}
			}
		},
		"/clientes": {
			"get": {
				"tags": ["Clientes"],
				"summary": "Listar todos los clientes",
				"description": "Obtiene el listado completo de clientes registrados en el sistema. Opcionalmente puede filtrar por ID de cliente.",
				"operationId": "getClientes",
				"parameters": [
					{
						"name": "cid",
						"in": "path",
						"description": "ID del cliente para filtrar (opcional)",
						"required": false,
						"schema": {
							"type": "integer",
							"example": 123
						}
					}
				],
				"responses": {
					"200": {
						"description": "Lista de clientes obtenida exitosamente",
						"content": {
							"application/json": {
								"schema": {
									"allOf": [
										{
											"properties": {
												"count": {
													"type": "integer",
													"example": 50
												},
												"data": {
													"type": "array",
													"items": {
														"$ref": "#/components/schemas/Customer"
													}
												}
											},
											"type": "object"
										},
										{
											"$ref": "#/components/schemas/SuccessResponse"
										}
									]
								}
							}
						}
					},
					"500": {
						"description": "Error interno del servidor",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ErrorResponse"
								}
							}
						}
					}
				}
			}
		},
		"/cliente": {
			"post": {
				"tags": ["Clientes"],
				"summary": "Crear o actualizar un cliente",
				"description": "Crea un nuevo cliente o actualiza uno existente según el email proporcionado. Para actualizar un cliente existente, incluir el ID en la URL (/cliente/{id}).",
				"operationId": "createOrUpdateCliente",
				"parameters": [
					{
						"name": "id",
						"in": "path",
						"description": "ID del cliente a actualizar (opcional). Si se omite, se crea un nuevo cliente.",
						"required": false,
						"schema": {
							"type": "integer",
							"example": 123
						}
					}
				],
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"$ref": "#/components/schemas/CustomerRequest"
							}
						}
					}
				},
				"responses": {
					"200": {
						"description": "Cliente creado o actualizado exitosamente",
						"content": {
							"application/json": {
								"schema": {
									"allOf": [
										{
											"properties": {
												"client_id": {
													"type": "integer",
													"example": 123
												}
											},
											"type": "object"
										},
										{
											"$ref": "#/components/schemas/SuccessResponse"
										}
									]
								}
							}
						}
					},
					"400": {
						"description": "Datos inválidos",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ErrorResponse"
								}
							}
						}
					},
					"404": {
						"description": "Cliente no encontrado (al actualizar)",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ErrorResponse"
								}
							}
						}
					},
					"409": {
						"description": "Email duplicado",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ErrorResponse"
								}
							}
						}
					},
					"422": {
						"description": "Validación fallida",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ErrorResponse"
								}
							}
						}
					},
					"500": {
						"description": "Error interno del servidor",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ErrorResponse"
								}
							}
						}
					}
				}
			}
		},
		"/usuarios": {
			"get": {
				"tags": ["Usuarios"],
				"summary": "Listar usuarios (vendedores/admins)",
				"description": "Obtiene el listado de usuarios con rol vendedor o administrador",
				"operationId": "getUsuarios",
				"responses": {
					"200": {
						"description": "Lista de usuarios obtenida exitosamente",
						"content": {
							"application/json": {
								"schema": {
									"allOf": [
										{
											"properties": {
												"count": {
													"type": "integer",
													"example": 10
												},
												"data": {
													"type": "array",
													"items": {
														"$ref": "#/components/schemas/User"
													}
												}
											},
											"type": "object"
										},
										{
											"$ref": "#/components/schemas/SuccessResponse"
										}
									]
								}
							}
						}
					},
					"500": {
						"description": "Error interno del servidor",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ErrorResponse"
								}
							}
						}
					}
				}
			}
		},
		"/login": {
			"post": {
				"tags": ["Autenticación"],
				"summary": "Login con PIN",
				"description": "Autentica un vendedor o administrador usando su PIN numérico enviado como parámetro de consulta",
				"operationId": "loginWithPIN",
				"parameters": [
					{
						"name": "data",
						"in": "query",
						"description": "PIN de autenticación (user_login numérico)",
						"required": true,
						"schema": {
							"type": "string",
							"example": "1234"
						}
					}
				],
				"responses": {
					"200": {
						"description": "Autenticación exitosa",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/LoginResponse"
								}
							}
						}
					},
					"400": {
						"description": "PIN no proporcionado",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ErrorResponse"
								}
							}
						}
					},
					"401": {
						"description": "PIN o credenciales inválidos",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ErrorResponse"
								}
							}
						}
					},
					"500": {
						"description": "Error interno del servidor",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ErrorResponse"
								}
							}
						}
					}
				}
			}
		},
		"/pedidos": {
			"get": {
				"tags": ["Pedidos"],
				"summary": "Listar todos los pedidos",
				"description": "Obtiene el listado de pedidos con items, totales e información del cliente. Opcionalmente puede filtrar por ID de vendedor.",
				"operationId": "getPedidos",
				"parameters": [
					{
						"name": "userId",
						"in": "path",
						"description": "ID del vendedor para filtrar pedidos (opcional)",
						"required": false,
						"schema": {
							"type": "integer",
							"example": 1044
						}
					}
				],
				"responses": {
					"200": {
						"description": "Lista de pedidos obtenida exitosamente",
						"content": {
							"application/json": {
								"schema": {
									"allOf": [
										{
											"properties": {
												"count": {
													"type": "integer",
													"example": 25
												},
												"data": {
													"type": "array",
													"items": {
														"$ref": "#/components/schemas/Order"
													}
												}
											},
											"type": "object"
										},
										{
											"$ref": "#/components/schemas/SuccessResponse"
										}
									]
								}
							}
						}
					},
					"500": {
						"description": "Error interno del servidor",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ErrorResponse"
								}
							}
						}
					}
				}
			}
		},
		"/pedido": {
			"post": {
				"tags": ["Pedidos"],
				"summary": "Crear un nuevo pedido",
				"description": "Crea un nuevo pedido de requisición con productos y datos del cliente",
				"operationId": "createPedido",
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"$ref": "#/components/schemas/OrderRequest"
							}
						}
					}
				},
				"responses": {
					"201": {
						"description": "Pedido creado exitosamente",
						"content": {
							"application/json": {
								"schema": {
									"allOf": [
										{
											"properties": {
												"order_id": {
													"type": "integer",
													"example": 1234
												},
												"order_total": {
													"type": "number",
													"format": "float",
													"example": 299.99
												},
												"items_count": {
													"type": "integer",
													"example": 3
												}
											},
											"type": "object"
										},
										{
											"$ref": "#/components/schemas/SuccessResponse"
										}
									]
								}
							}
						}
					},
					"400": {
						"description": "Datos inválidos",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ErrorResponse"
								}
							}
						}
					},
					"401": {
						"description": "No autorizado - Token Bearer requerido",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ErrorResponse"
								}
							}
						}
					},
					"403": {
						"description": "Prohibido - Usuario sin permisos",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ErrorResponse"
								}
							}
						}
					},
					"404": {
						"description": "Cliente no encontrado",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ErrorResponse"
								}
							}
						}
					},
					"422": {
						"description": "Validación fallida",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ErrorResponse"
								}
							}
						}
					},
					"500": {
						"description": "Error interno del servidor",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ErrorResponse"
								}
							}
						}
					}
				},
				"security": [
					{
						"bearerAuth": []
					}
				]
			}
		},
		"/pedido/{id}/pdf": {
			"get": {
				"tags": ["Pedidos"],
				"summary": "Descargar pedido en PDF",
				"description": "Genera y descarga un PDF del pedido usando la plantilla invoice-2.html",
				"operationId": "downloadPedidoPdf",
				"parameters": [
					{
						"name": "id",
						"in": "path",
						"description": "ID del pedido",
						"required": true,
						"schema": {
							"type": "integer",
							"example": 1234
						}
					}
				],
				"responses": {
					"200": {
						"description": "PDF generado exitosamente (Content-Type: application/pdf, Content-Disposition: attachment)"
					},
					"401": {
						"description": "No autorizado",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ErrorResponse"
								}
							}
						}
					},
					"404": {
						"description": "Pedido no encontrado",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ErrorResponse"
								}
							}
						}
					},
					"500": {
						"description": "Error interno del servidor",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ErrorResponse"
								}
							}
						}
					}
				},
				"security": [
					{
						"bearerAuth": []
					}
				]
			}
		},
		"/pedido/{id}/enviar": {
			"post": {
				"tags": ["Pedidos"],
				"summary": "Enviar pedido por email",
				"description": "Envía el pedido por email al vendedor y al cliente usando la configuración SMTP del .env. Requiere autenticación de vendedor.",
				"operationId": "enviarPedidoEmail",
				"parameters": [
					{
						"name": "id",
						"in": "path",
						"description": "ID del pedido",
						"required": true,
						"schema": {
							"type": "integer",
							"example": 1234
						}
					}
				],
				"responses": {
					"200": {
						"description": "Email enviado exitosamente",
						"content": {
							"application/json": {
								"schema": {
									"allOf": [
										{
											"properties": {
												"recipients": {
													"type": "array",
													"items": {
														"type": "string"
													},
													"example": ["vendedor@email.com", "cliente@email.com"]
												}
											},
											"type": "object"
										},
										{
											"$ref": "#/components/schemas/SuccessResponse"
										}
									]
								}
							}
						}
					},
					"401": {
						"description": "No autorizado",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ErrorResponse"
								}
							}
						}
					},
					"404": {
						"description": "Pedido no encontrado",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ErrorResponse"
								}
							}
						}
					},
					"500": {
						"description": "Error interno del servidor o SMTP no configurado",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ErrorResponse"
								}
							}
						}
					}
				},
				"security": [
					{
						"bearerAuth": []
					}
				]
			}
		}
	},
	"components": {
		"schemas": {
			"PaginationMeta": {
				"properties": {
					"total": {
						"type": "integer",
						"example": 100
					},
					"page": {
						"type": "integer",
						"example": 1
					},
					"per_page": {
						"type": "integer",
						"example": 10
					},
					"total_pages": {
						"type": "integer",
						"example": 10
					}
				},
				"type": "object"
			},
			"ErrorResponse": {
				"properties": {
					"success": {
						"type": "boolean",
						"example": false
					},
					"message": {
						"type": "string",
						"example": "Error descripción"
					},
					"code": {
						"type": "integer",
						"example": 400,
						"nullable": true
					}
				},
				"type": "object"
			},
			"Product": {
				"properties": {
					"product_id": {
						"description": "ID del producto",
						"type": "integer",
						"example": 123
					},
					"nombre_producto": {
						"description": "Nombre del producto",
						"type": "string",
						"example": "Producto Ejemplo"
					},
					"variaciones": {
						"description": "Variaciones del producto en formato string",
						"type": "string",
						"example": "vid:456|Título:Var1|Stock:10|Precio:99.99",
						"nullable": true
					},
					"filtros": {
						"description": "Filtros aplicados al producto",
						"type": "string",
						"example": "Termino:Color|Slug:rojo",
						"nullable": true
					}
				},
				"type": "object"
			},
			"Customer": {
				"properties": {
					"ID": {
						"description": "ID único del cliente",
						"type": "integer",
						"example": 1
					},
					"user_login": {
						"description": "Nombre de usuario para login",
						"type": "string",
						"example": "cliente123"
					},
					"display_name": {
						"description": "Nombre para mostrar",
						"type": "string",
						"example": "Juan Pérez"
					},
					"user_email": {
						"description": "Email principal",
						"type": "string",
						"format": "email",
						"example": "juan@email.com"
					},
					"first_name": {
						"description": "Nombre",
						"type": "string",
						"example": "Juan",
						"nullable": true
					},
					"last_name": {
						"description": "Apellido",
						"type": "string",
						"example": "Pérez",
						"nullable": true
					},
					"billing_first_name": {
